# Copy to .env (gitignored) and fill in. Never commit real values.

# nanoHUB OAuth (password grant) for querying ResultsDB outside a tool session.
# Create a web app at https://nanohub.org/developer/api/applications to get a client id/secret.
NANOHUB_CLIENT_ID=
NANOHUB_CLIENT_SECRET=
NANOHUB_USERNAME=
NANOHUB_PASSWORD=

# Materials Project API key (h-BN workflow). Same variable name AURA uses.
MP_API=
